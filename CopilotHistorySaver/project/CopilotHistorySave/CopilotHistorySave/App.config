<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- コマンドライン引数を省略した場合の既定値。未指定の場合は空のままでよい。 -->
        <add key="InputPath" value="" />
        <add key="OutputPath" value="" />
    </appSettings>
</configuration>